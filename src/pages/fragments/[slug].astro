---
import Base from '../../layouts/Base.astro';
import { fragments, slugFromFile } from '../../lib/content';
export function getStaticPaths() { return fragments.map(item => ({ params: { slug: slugFromFile(item.file) }, props: { item } })); }
const { item } = Astro.props; const fm = item.frontmatter;
---
<Base title={`${fm.title} · Fragments · Azhar Maruf`}>
  <article class="detail container"><header class="detail-head"><h1 class="detail-title">{fm.title}</h1><div class="detail-meta">Fragment</div></header><div class="detail-body"><item.Content /></div></article>
</Base>
