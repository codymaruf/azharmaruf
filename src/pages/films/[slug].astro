---
import Base from '../../layouts/Base.astro';
import { films, slugFromFile, youtubeId } from '../../lib/content';
export function getStaticPaths() { return films.map(item => ({ params: { slug: slugFromFile(item.file) }, props: { item } })); }
const { item } = Astro.props; const fm = item.frontmatter; const id = youtubeId(fm.youtube);
---
<Base title={`${fm.title} · Azhar Maruf`}>
  <article class="detail container">
    <header class="detail-head"><h1 class="detail-title">{fm.title}</h1><div class="detail-meta">{fm.type} · {fm.year} · {fm.status}</div></header>
    {id && <div class="detail-media"><iframe class="video-frame" src={`https://www.youtube.com/embed/${id}`} title={fm.title} allowfullscreen loading="lazy"></iframe></div>}
    <div class="detail-body"><p>{fm.description}</p><p><a class="text-link" href={fm.youtube} target="_blank" rel="noreferrer">WATCH ON YOUTUBE →</a></p></div>
  </article>
</Base>
