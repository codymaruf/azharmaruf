---
import { youtubeId } from '../lib/content';

const { item, href, action } = Astro.props;
const fm = item.frontmatter;
const id = youtubeId(fm.youtube);
const image = fm.image || (id ? `https://img.youtube.com/vi/${id}/maxresdefault.jpg` : '');
const meta = [fm.type, fm.year, fm.status].filter(Boolean).join(' · ');
const buttonText = action || (fm.description ? 'READ' : 'SEE MORE');
---

<a class={`gallery-card ${image ? '' : 'no-visual'}`} href={href}>
  {image && (
    <div class="gallery-card-media">
      <img
        src={image}
        alt={fm.title}
        loading="lazy"
        onerror={`this.onerror=null;this.src='https://img.youtube.com/vi/${id}/hqdefault.jpg'`}
      />
    </div>
  )}

  <div class="gallery-card-meta">{meta}</div>
  <div class="gallery-card-title">{fm.title}</div>

  {fm.description && <div class="gallery-card-description">{fm.description}</div>}

  <span class="card-action">{buttonText} →</span>
</a>
