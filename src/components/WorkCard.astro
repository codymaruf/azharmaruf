---
import { youtubeId } from '../lib/content';

const { item, href } = Astro.props;
const fm = item.frontmatter;
const title = fm.title ?? 'Untitled';
const id = youtubeId(fm.youtube);
const image = fm.image || (id ? `https://img.youtube.com/vi/${id}/maxresdefault.jpg` : '');
const meta = [fm.type, fm.year, fm.status].filter(Boolean).join(' · ');
---

<a class={`work-card ${image ? '' : 'no-visual'}`} href={href}>
  {image && (
    <div class="card-media">
      <img
        src={image}
        alt={title}
        loading="lazy"
        onerror={`this.onerror=null;this.src='https://img.youtube.com/vi/${id}/hqdefault.jpg'`}
      />
    </div>
  )}

  <div class="card-meta">{meta}</div>
  <div class="card-title">{title}</div>
  {fm.description && <div class="card-description">{fm.description}</div>}
  <span class="card-action">{fm.description ? 'READ' : 'SEE MORE'} →</span>
</a>
